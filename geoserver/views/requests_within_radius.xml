<featureType>
  <name>requests_within_radius</name>
  <nativeName>requests_within_radius</nativeName>
  <title>Service requests within a radius of a point</title>
  <srs>EPSG:4326</srs>
  <nativeBoundingBox><minx>31.2</minx><maxx>31.36</maxx><miny>30.0</miny><maxy>30.09</maxy><crs>EPSG:4326</crs></nativeBoundingBox>
  <latLonBoundingBox><minx>31.2</minx><maxx>31.36</maxx><miny>30.0</miny><maxy>30.09</maxy><crs>EPSG:4326</crs></latLonBoundingBox>
  <metadata>
    <entry key="JDBC_VIRTUAL_TABLE">
      <virtualTable>
        <name>requests_within_radius</name>
        <sql>SELECT r.id, r.category, r.status, r.priority, r.description, r.created_at,
       round(ST_Distance(r.geom::geography, p.g::geography))::int AS distance_m,
       r.geom
FROM service_requests r,
     (SELECT ST_SetSRID(ST_MakePoint(%lon%, %lat%), 4326) AS g) p
WHERE ST_DWithin(r.geom::geography, p.g::geography, %radius%)
  AND r.category = ANY (string_to_array('%cats%', ' '))
  AND r.status = ANY (string_to_array('%sts%', ' '))
  AND ('%prio%' = 'all' OR r.priority = '%prio%')
  AND (%days% = 0 OR r.created_at &gt;= now() - make_interval(days =&gt; %days%))
ORDER BY distance_m</sql>
        <escapeSql>false</escapeSql>
        <keyColumn>id</keyColumn>
        <geometry><name>geom</name><type>Point</type><srid>4326</srid></geometry>
        <parameter><name>lon</name><defaultValue>31.28</defaultValue><regexpValidator>^-?\d{1,3}(\.\d+)?$</regexpValidator></parameter>
        <parameter><name>lat</name><defaultValue>30.045</defaultValue><regexpValidator>^-?\d{1,2}(\.\d+)?$</regexpValidator></parameter>
        <parameter><name>cats</name><defaultValue>road water lighting waste</defaultValue><regexpValidator>^(road|water|lighting|waste)( (road|water|lighting|waste))*$</regexpValidator></parameter>
        <parameter><name>sts</name><defaultValue>new in_review approved rejected</defaultValue><regexpValidator>^(new|in_review|approved|rejected)( (new|in_review|approved|rejected))*$</regexpValidator></parameter>
        <parameter><name>prio</name><defaultValue>all</defaultValue><regexpValidator>^(all|low|normal|high)$</regexpValidator></parameter>
        <parameter><name>days</name><defaultValue>0</defaultValue><regexpValidator>^\d{1,4}$</regexpValidator></parameter>
        <parameter><name>radius</name><defaultValue>500</defaultValue><regexpValidator>^\d{1,5}$</regexpValidator></parameter>
      </virtualTable>
    </entry>
  </metadata>
</featureType>
